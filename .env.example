APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://si4810-bhima.laravel.cloud
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bhima
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Konfigurasi Asisten Hukum Virtual (RAG AI)
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.26
RAG_SEMANTIC_WEIGHT=0.60
RAG_KEYWORD_WEIGHT=0.40
RAG_CHUNK_MAX_CHARS=600
RAG_CHUNK_OVERLAP_CHARS=120

# Konfigurasi Embedding (local | api)
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=bhima-legal-embed-v1
RAG_EMBEDDING_DIMENSIONS=128
RAG_EMBEDDING_TIMEOUT=10

# Konfigurasi LLM Generasi Jawaban (local_grounded | api)
# Samakan endpoint, model, dan key dengan DEEPSEEK_* (bila RAG_LLM_API_KEY kosong akan mewarisi DEEPSEEK_API_KEY)
RAG_LLM_PROVIDER=local_grounded
RAG_LLM_BASE_URL=https://ai.paas.id
RAG_LLM_API_KEY=
RAG_LLM_MODEL=deepseek-v4.1-flash
RAG_LLM_TEMPERATURE=0.1
RAG_LLM_MAX_TOKENS=1200
RAG_LLM_TIMEOUT=20

# Keamanan & Batas Konsultasi Publik
RAG_MIN_CHRONOLOGY_LENGTH=10
RAG_MAX_CHRONOLOGY_LENGTH=4000
RAG_RATE_LIMIT_PER_MINUTE=15

# Konfigurasi Analisis Pasal, Ancaman Sanksi & Eskalasi (PBI 2: mock | deepseek)
# Ubah ke LLM_PROVIDER=deepseek dan RAG_LLM_PROVIDER=api setelah DEEPSEEK_API_KEY diisi di .env lokal
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://ai.paas.id
DEEPSEEK_MODEL=deepseek-v4.1-flash
DEEPSEEK_SEND_RESPONSE_FORMAT=true
DEEPSEEK_TIMEOUT=20
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_TOKENS=1500
ANALYSIS_RATE_LIMIT_PER_MINUTE=15

# Kuota Token Harian & Circuit Breaker LLM (PBI 3)
LLM_DAILY_TOKEN_LIMIT=200000
LLM_DAILY_REQUEST_LIMIT=500
LLM_PER_REQUEST_TOKEN_CAP=3000
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_MINUTES=5
